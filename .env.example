# Copy this file to .env and adjust values.

# Long random string used to sign sessions / cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

FLASK_ENV=development
FLASK_DEBUG=1

# SQLite database file. Leave unset to use instance/step_challenge.db automatically.
# DATABASE_URL=sqlite:////absolute/path/to/step_challenge.db

# Name shown throughout the app
CHALLENGE_NAME=Steptember

# Optional ISO date (YYYY-MM-DD) the challenge officially starts.
# Steps cannot be recorded for dates before this. Leave blank for no restriction.
CHALLENGE_START_DATE=2026-01-01

# Optional ISO date (YYYY-MM-DD) the challenge ends. Leave blank for no restriction.
CHALLENGE_END_DATE=

# Max plausible steps allowed in a single day (validation upper bound)
MAX_PLAUSIBLE_DAILY_STEPS=100000

# Remember-me / session lifetime in days (requirement: at least 35)
REMEMBER_COOKIE_DAYS=35

# Max upload size for team images, in megabytes
MAX_UPLOAD_MB=5
